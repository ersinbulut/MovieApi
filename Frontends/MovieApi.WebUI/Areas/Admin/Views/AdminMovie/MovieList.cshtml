@model List<AdminResultMovieDto>

@{
    ViewData["Title"] = "Film Listesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<style>
    .category-badge {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .cat-komedi {
        background: rgba(251,191,36,.15);
        color: #f59e0b;
    }

    .cat-dram {
        background: rgba(236,72,153,.15);
        color: #ec4899;
    }

    .cat-seruven {
        background: rgba(34,197,94,.15);
        color: #22c55e;
    }

    .cat-animasyon {
        background: rgba(168,85,247,.15);
        color: #a855f7;
    }

    .cat-macera {
        background: rgba(14,165,233,.15);
        color: #0ea5e9;
    }

    .cat-belgesel {
        background: rgba(156,163,175,.15);
        color: #6b7280;
    }

    .cat-gerilim {
        background: rgba(139,92,246,.15);
        color: #8b5cf6;
    }

    .cat-korku {
        background: rgba(239,68,68,.15);
        color: #ef4444;
    }

    .cat-bilimkurgu {
        background: rgba(59,130,246,.15);
        color: #3b82f6;
    }

    .cat-aksiyon {
        background: rgba(220,38,38,.15);
        color: #dc2626;
    }

    .cat-romantik {
        background: rgba(251,113,133,.15);
        color: #fb7185;
    }
</style>

<div class="cinema-shell">
    <div class="cinema-topbar">
        <h5>🎬 Film Yönetim Paneli</h5>
        <a href="/Admin/AdminMovie/CreateMovie" class="btn btn-primary">Yeni Film</a>
    </div>

    <div class="cinema-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Film</th>
                    <th>Kategori</th>
                    <th>Reyting</th>
                    <th>Yıl</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        count++;

                        string title = item.Title ?? "-";
                        string categoryName = item.CategoryName ?? "Kategori Yok";
                        string statusText = item.Status ?? "";
                        bool isActive = statusText == "True" || statusText == "1";

                        string categoryNormalized = categoryName
                        .ToLowerInvariant()
                        .Replace("ü", "u")
                        .Replace("ğ", "g")
                        .Replace("ş", "s")
                        .Replace("ç", "c")
                        .Replace("ö", "o")
                        .Replace("ı", "i");

                        string icon = categoryNormalized switch
                        {
                            "komedi" => "happy-outline",
                            "dram" => "heart-outline",
                            "seruven" => "compass-outline",
                            "animasyon" => "color-palette-outline",
                            "macera" => "map-outline",
                            "belgesel" => "book-outline",
                            "gerilim" => "eye-outline",
                            "korku" => "skull-outline",
                            "bilimkurgu" => "rocket-outline",
                            "aksiyon" => "flash-outline",
                            "romantik" => "rose-outline",
                            _ => "film-outline"
                        };

                        <tr>
                            <td>@count</td>
                            <td>@title</td>

                            <td>
                                <span class="category-badge cat-@categoryNormalized">
                                    <ion-icon name="@icon"></ion-icon>
                                    @categoryName
                                </span>
                            </td>

                            <td>⭐ @item.Rating</td>
                            <td>@item.CreatedYear</td>

                            <td>
                                <span class="badge @(isActive ? "bg-success" : "bg-secondary")">
                                    @(isActive ? "Yayında" : "Taslak")
                                </span>
                            </td>

                            <td>
                                <a href="/Admin/AdminMovie/Update/@item.MovieId" class="btn btn-warning btn-sm">Güncelle</a>
                                <a href="/Admin/AdminMovie/Detail/@item.MovieId" class="btn btn-info btn-sm">Detay</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            Film bulunamadı
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
